{
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "tui": "fullscreen"
}
